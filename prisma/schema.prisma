generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  fornecedor
  sindico
  administradora
  master_admin
}

enum MemberRole {
  master
  operational
}

enum PlanAudience {
  solicitante
  fornecedor
  platform
}

enum SubscriptionStatus {
  pending
  paid
  active
  failed
  canceled
  past_due
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firebaseUid          String?   @unique
  name                 String
  emailVerifiedAt      DateTime?
  privacyAcceptedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships          OrganizationMember[]
  emailTokens          EmailToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  consentRecords       ConsentRecord[]
}

enum QuotationStatus {
  aberta
  em_negociacao
  aprovada
  recusada
  cancelada
  encerrada
  finalizada_outros
}

enum QuotationUrgency {
  baixa
  media
  alta
  critica
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  document  String?
  type      OrganizationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members              OrganizationMember[]
  subscriptions        Subscription[]
  planOverrides        PlanOverride[]
  condominiums         Condominium[]
  quotations           Quotation[]
  franchiseUsages      FranchiseUsage[]
  domainEvents         DomainEvent[]
  categories           OrganizationCategory[]
  complianceDocuments  ComplianceDocument[]
  quotationInvites     QuotationInvite[]
  proposals            Proposal[]
  favoriteSuppliers    FavoriteSupplier[]      @relation("FavoriteOwner")
  favoritedBy          FavoriteSupplier[]      @relation("FavoriteSupplierOrg")
  negotiationMessages  NegotiationMessage[]
}

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(master)
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Plan {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  audience     PlanAudience
  isFree       Boolean      @default(false)
  monthlyQuota Int?
  priceCents   Int          @default(0)
  featuresJson String       @default("{}")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]
  overrides     PlanOverride[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  status         SubscriptionStatus @default(active)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
}

model PlanOverride {
  id             String   @id @default(cuid())
  organizationId String
  planId         String?
  monthlyQuota   Int?
  featuresJson   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@unique([organizationId])
}

model ServiceCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  colorToken String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items              ServiceItem[]
  quotations         Quotation[]
  organizationLinks  OrganizationCategory[]
  favoriteLinks      FavoriteSupplier[]
}

model OrganizationCategory {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  isIncluded     Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
}

enum ComplianceStatus {
  aprovado
  em_analise
  em_atraso
  negada
}

model ComplianceDocument {
  id             String           @id @default(cuid())
  organizationId String
  documentType   String
  fileName       String
  storagePath    String
  contentType    String?
  sizeBytes      Int              @default(0)
  validUntil     DateTime
  status         ComplianceStatus @default(em_analise)
  reviewNotes    String?
  reviewedAt     DateTime?
  reviewedByUserId String?
  replacesId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replaces     ComplianceDocument? @relation("ComplianceHistory", fields: [replacesId], references: [id], onDelete: SetNull)
  renewals     ComplianceDocument[] @relation("ComplianceHistory")

  @@index([organizationId, status])
  @@index([organizationId, documentType])
  @@index([validUntil])
}

enum InviteStatus {
  pendente
  aceito
  declinado
  expirado
}

enum ProposalStatus {
  enviada
  em_negociacao
  aprovada
  recusada
}

model QuotationInvite {
  id                   String       @id @default(cuid())
  quotationId          String
  supplierOrgId        String
  status               InviteStatus @default(pendente)
  priorityTier         Int          @default(4)
  selectionReason      String?
  declineReason        String?
  acceptedAt           DateTime?
  declinedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  quotation  Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier   Organization @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  proposal   Proposal?

  @@unique([quotationId, supplierOrgId])
  @@index([supplierOrgId, status])
  @@index([quotationId])
}

model Proposal {
  id             String         @id @default(cuid())
  inviteId       String         @unique
  organizationId String
  quotationId    String
  status         ProposalStatus @default(enviada)
  createdByUserId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invite       QuotationInvite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  conditions   ProposalCondition[]
  messages     NegotiationMessage[]

  @@index([organizationId, status])
  @@index([quotationId])
}

model NegotiationMessage {
  id             String   @id @default(cuid())
  proposalId     String
  organizationId String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  proposal     Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model FavoriteSupplier {
  id             String   @id @default(cuid())
  organizationId String
  supplierOrgId  String
  categoryId     String?
  createdAt      DateTime @default(now())

  organization Organization     @relation("FavoriteOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Organization     @relation("FavoriteSupplierOrg", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, supplierOrgId])
  @@index([organizationId])
  @@index([supplierOrgId])
}

model ProposalCondition {
  id            String   @id @default(cuid())
  proposalId    String
  amountCents   Int
  paymentTerms  String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  proposal    Proposal                     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  attachments ProposalConditionAttachment[]

  @@index([proposalId])
}

model ProposalConditionAttachment {
  id          String   @id @default(cuid())
  conditionId String
  fileName    String
  storagePath String
  contentType String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  condition ProposalCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ServiceItem {
  id              String    @id @default(cuid())
  categoryId      String
  name            String
  slug            String
  isMandatory     Boolean   @default(false)
  periodicityHint String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quotations Quotation[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Condominium {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  address        String
  document       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Quotation {
  id                    String           @id @default(cuid())
  publicId              String           @unique
  organizationId        String
  condominiumId         String
  categoryId            String
  serviceItemId         String
  urgency               QuotationUrgency @default(media)
  description           String
  minProposals          Int              @default(3)
  maxProposals          Int              @default(10)
  proposalsCount        Int              @default(0)
  invitesPaused         Boolean          @default(false)
  status                QuotationStatus  @default(aberta)
  approvedProposalId    String?
  approvedConditionId   String?
  otherCompanyName      String?
  otherFinalAmountCents Int?
  createdByUserId       String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  condominium  Condominium            @relation(fields: [condominiumId], references: [id])
  category     ServiceCategory        @relation(fields: [categoryId], references: [id])
  serviceItem  ServiceItem            @relation(fields: [serviceItemId], references: [id])
  attachments  QuotationAttachment[]
  invites      QuotationInvite[]
  proposals    Proposal[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([categoryId])
  @@index([serviceItemId])
}

model QuotationAttachment {
  id          String   @id @default(cuid())
  quotationId String
  fileName    String
  storagePath String
  contentType String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model FranchiseUsage {
  id             String   @id @default(cuid())
  organizationId String
  yearMonth      String
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
}

model DomainEvent {
  id             String   @id @default(cuid())
  type           String
  entityType     String
  entityId       String
  organizationId String?
  payload        String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([organizationId])
  @@index([entityType, entityId])
}

model LandingBanner {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingSettings {
  id             String   @id @default("default")
  whatsappUrl    String?
  blogUrl        String?
  pixelScripts   String?
  supplierLpHost String?
  updatedAt      DateTime @updatedAt
}

model PlatformSettings {
  id                      String   @id @default("default")
  freeQuotaSolicitante    Int      @default(15)
  freeQuotaFornecedor     Int      @default(1)
  reminderDaysJson        String   @default("[5,10]")
  partnershipLockEnabled  Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String
  accepted  Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
