generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  fornecedor
  sindico
  administradora
  master_admin
}

enum MemberRole {
  master
  operational
}

enum PlanAudience {
  solicitante
  fornecedor
  platform
}

enum SubscriptionStatus {
  pending
  paid
  active
  failed
  canceled
  past_due
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firebaseUid          String?   @unique
  name                 String
  emailVerifiedAt      DateTime?
  privacyAcceptedAt    DateTime?
  referralCode         String?   @unique
  referredByUserId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships          OrganizationMember[]
  emailTokens          EmailToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  consentRecords       ConsentRecord[]
  referredBy           User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals            User[]    @relation("UserReferrals")
  referralRewards      ReferralReward[] @relation("ReferralReferrer")
  referredRewards      ReferralReward[] @relation("ReferralReferred")
}

enum QuotationStatus {
  aberta
  em_negociacao
  aprovada
  recusada
  cancelada
  encerrada
  finalizada_outros
}

enum QuotationUrgency {
  baixa
  media
  alta
  critica
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  document  String?
  type      OrganizationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members              OrganizationMember[]
  subscriptions        Subscription[]
  planOverrides        PlanOverride[]
  condominiums         Condominium[]
  quotations           Quotation[]
  franchiseUsages      FranchiseUsage[]
  domainEvents         DomainEvent[]
  categories           OrganizationCategory[]
  complianceDocuments  ComplianceDocument[]
  quotationInvites     QuotationInvite[]
  proposals            Proposal[]
  favoriteSuppliers    FavoriteSupplier[]      @relation("FavoriteOwner")
  favoritedBy          FavoriteSupplier[]      @relation("FavoriteSupplierOrg")
  negotiationMessages  NegotiationMessage[]
  paymentCheckouts     PaymentCheckout[]
  subscriptionChanges  SubscriptionChange[]
  migrations           OrganizationMigration[]
  partnershipsAsAdm    Partnership[]           @relation("PartnershipAdm")
  partnershipsAsSupplier Partnership[]         @relation("PartnershipSupplier")
  commissionAgreements CommissionAgreement[]   @relation("CommissionAdm")
  commissionAsSupplier CommissionAgreement[]   @relation("CommissionSupplier")
  commissionEntries    CommissionEntry[]       @relation("CommissionEntryAdm")
  commissionEntrySupplier CommissionEntry[]    @relation("CommissionEntrySupplier")
  categoryAddonPurchases CategoryAddonPurchase[]
}

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(master)
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Plan {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  description     String?
  audience        PlanAudience
  isFree          Boolean      @default(false)
  monthlyQuota    Int?
  priceCents      Int          @default(0)
  billingInterval String       @default("monthly")
  sortOrder       Int          @default(0)
  featuresJson    String       @default("{}")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptions       Subscription[]
  overrides           PlanOverride[]
  checkouts           PaymentCheckout[]
  changesFrom         SubscriptionChange[] @relation("ChangeFromPlan")
  changesTo           SubscriptionChange[] @relation("ChangeToPlan")
  migrations          OrganizationMigration[]
  pendingSubscriptions Subscription[]     @relation("PendingPlan")
}

model Subscription {
  id                    String             @id @default(cuid())
  organizationId        String
  planId                String
  status                SubscriptionStatus @default(active)
  startsAt              DateTime           @default(now())
  endsAt                DateTime?
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  pendingPlanId         String?
  externalCustomerId    String?
  externalSubscriptionId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model PlanOverride {
  id             String   @id @default(cuid())
  organizationId String
  planId         String?
  monthlyQuota   Int?
  featuresJson   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@unique([organizationId])
}

model ServiceCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  colorToken String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items              ServiceItem[]
  quotations         Quotation[]
  organizationLinks  OrganizationCategory[]
  favoriteLinks      FavoriteSupplier[]
}

model OrganizationCategory {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  isIncluded     Boolean  @default(true)
  isAddon        Boolean  @default(false)
  unitPriceCents Int?
  checkoutId     String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  checkout     PaymentCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@unique([organizationId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
}

enum ComplianceStatus {
  aprovado
  em_analise
  em_atraso
  negada
}

model ComplianceDocument {
  id             String           @id @default(cuid())
  organizationId String
  documentType   String
  fileName       String
  storagePath    String
  contentType    String?
  sizeBytes      Int              @default(0)
  validUntil     DateTime
  status         ComplianceStatus @default(em_analise)
  reviewNotes    String?
  reviewedAt     DateTime?
  reviewedByUserId String?
  replacesId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replaces     ComplianceDocument? @relation("ComplianceHistory", fields: [replacesId], references: [id], onDelete: SetNull)
  renewals     ComplianceDocument[] @relation("ComplianceHistory")

  @@index([organizationId, status])
  @@index([organizationId, documentType])
  @@index([validUntil])
}

enum InviteStatus {
  pendente
  aceito
  declinado
  expirado
}

enum ProposalStatus {
  enviada
  em_negociacao
  aprovada
  recusada
}

model QuotationInvite {
  id                   String       @id @default(cuid())
  quotationId          String
  supplierOrgId        String
  status               InviteStatus @default(pendente)
  priorityTier         Int          @default(4)
  selectionReason      String?
  declineReason        String?
  acceptedAt           DateTime?
  declinedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  quotation  Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier   Organization @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  proposal   Proposal?

  @@unique([quotationId, supplierOrgId])
  @@index([supplierOrgId, status])
  @@index([quotationId])
}

model Proposal {
  id             String         @id @default(cuid())
  inviteId       String         @unique
  organizationId String
  quotationId    String
  status         ProposalStatus @default(enviada)
  createdByUserId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invite       QuotationInvite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  conditions   ProposalCondition[]
  messages     NegotiationMessage[]

  @@index([organizationId, status])
  @@index([quotationId])
}

model NegotiationMessage {
  id             String   @id @default(cuid())
  proposalId     String
  organizationId String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  proposal     Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model FavoriteSupplier {
  id             String   @id @default(cuid())
  organizationId String
  supplierOrgId  String
  categoryId     String?
  createdAt      DateTime @default(now())

  organization Organization     @relation("FavoriteOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Organization     @relation("FavoriteSupplierOrg", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, supplierOrgId])
  @@index([organizationId])
  @@index([supplierOrgId])
}

model ProposalCondition {
  id            String   @id @default(cuid())
  proposalId    String
  amountCents   Int
  paymentTerms  String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  proposal    Proposal                     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  attachments ProposalConditionAttachment[]

  @@index([proposalId])
}

model ProposalConditionAttachment {
  id          String   @id @default(cuid())
  conditionId String
  fileName    String
  storagePath String
  contentType String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  condition ProposalCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ServiceItem {
  id              String    @id @default(cuid())
  categoryId      String
  name            String
  slug            String
  isMandatory     Boolean   @default(false)
  periodicityHint String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quotations Quotation[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Condominium {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  address        String
  document       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  towers         Int?
  units          Int?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Quotation {
  id                    String           @id @default(cuid())
  publicId              String           @unique
  organizationId        String
  condominiumId         String
  categoryId            String
  serviceItemId         String
  urgency               QuotationUrgency @default(media)
  description           String
  minProposals          Int              @default(3)
  maxProposals          Int              @default(10)
  proposalsCount        Int              @default(0)
  invitesPaused         Boolean          @default(false)
  status                QuotationStatus  @default(aberta)
  approvedProposalId    String?
  approvedConditionId   String?
  otherCompanyName      String?
  otherFinalAmountCents Int?
  createdByUserId       String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  condominium  Condominium            @relation(fields: [condominiumId], references: [id])
  category     ServiceCategory        @relation(fields: [categoryId], references: [id])
  serviceItem  ServiceItem            @relation(fields: [serviceItemId], references: [id])
  attachments  QuotationAttachment[]
  invites      QuotationInvite[]
  proposals    Proposal[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([categoryId])
  @@index([serviceItemId])
}

model QuotationAttachment {
  id          String   @id @default(cuid())
  quotationId String
  fileName    String
  storagePath String
  contentType String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model FranchiseUsage {
  id             String   @id @default(cuid())
  organizationId String
  yearMonth      String
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
}

model DomainEvent {
  id             String   @id @default(cuid())
  type           String
  entityType     String
  entityId       String
  organizationId String?
  payload        String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([organizationId])
  @@index([entityType, entityId])
}

enum BannerAudienceMode {
  all
  profiles
  users
}

model LandingBanner {
  id                   String             @id @default(cuid())
  title                String?
  imageUrl             String
  linkUrl              String?
  sortOrder            Int                @default(0)
  isActive             Boolean            @default(true)
  showOnLanding        Boolean            @default(true)
  showInApp            Boolean            @default(true)
  audienceMode         BannerAudienceMode @default(all)
  targetProfilesJson   String             @default("[]")
  targetUserIdsJson    String             @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model MarketingSettings {
  id             String   @id @default("default")
  whatsappUrl    String?
  blogUrl        String?
  pixelScripts   String?
  supplierLpHost String?
  updatedAt      DateTime @updatedAt
}

model PlatformSettings {
  id                      String   @id @default("default")
  freeQuotaSolicitante    Int      @default(15)
  freeQuotaFornecedor     Int      @default(1)
  reminderDaysJson        String   @default("[5,10]")
  partnershipLockEnabled  Boolean  @default(true)
  categoryAddonPriceCents Int      @default(2900)
  updatedAt               DateTime @updatedAt
}

enum CheckoutKind {
  plan
  category_addon
  migration
}

enum CheckoutStatus {
  pending
  paid
  failed
  canceled
  expired
}

enum PartnershipStatus {
  active
  blocked
  ended
}

enum MigrationStatus {
  pending_payment
  pending_review
  approved
  rejected
  canceled
}

enum CommissionFeeType {
  fixed
  percent
}

enum CommissionEntryStatus {
  expected
  accrued
  paid
  canceled
}

model PaymentCheckout {
  id               String         @id @default(cuid())
  organizationId   String
  userId           String?
  kind             CheckoutKind
  planId           String?
  status           CheckoutStatus @default(pending)
  provider         String         @default("sandbox")
  amountCents      Int
  quantity         Int            @default(1)
  currency         String         @default("BRL")
  externalId       String?        @unique
  idempotencyKey   String         @unique
  metadataJson     String         @default("{}")
  paidAt           DateTime?
  failedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             Plan?          @relation(fields: [planId], references: [id])
  orgCategories    OrganizationCategory[]
  migrations       OrganizationMigration[]
  addonPurchases   CategoryAddonPurchase[]

  @@index([organizationId, status])
  @@index([kind])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payloadJson String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType])
}

model SubscriptionChange {
  id             String   @id @default(cuid())
  organizationId String
  fromPlanId     String?
  toPlanId       String
  changeType     String
  prorationCents Int      @default(0)
  effectiveAt    DateTime
  checkoutId     String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromPlan     Plan?        @relation("ChangeFromPlan", fields: [fromPlanId], references: [id])
  toPlan       Plan         @relation("ChangeToPlan", fields: [toPlanId], references: [id])

  @@index([organizationId, createdAt])
}

model OrganizationMigration {
  id             String           @id @default(cuid())
  organizationId String
  fromType       OrganizationType
  toType         OrganizationType @default(administradora)
  targetPlanId   String
  status         MigrationStatus  @default(pending_payment)
  checkoutId     String?
  requestedByUserId String
  reviewedByUserId  String?
  reviewNotes    String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetPlan   Plan             @relation(fields: [targetPlanId], references: [id])
  checkout     PaymentCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status])
}

model Partnership {
  id                  String            @id @default(cuid())
  administradoraOrgId String
  supplierOrgId       String
  status              PartnershipStatus @default(active)
  lockedReason        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  administradora Organization @relation("PartnershipAdm", fields: [administradoraOrgId], references: [id], onDelete: Cascade)
  supplier       Organization @relation("PartnershipSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)

  @@unique([administradoraOrgId, supplierOrgId])
  @@index([administradoraOrgId])
  @@index([supplierOrgId])
}

model CommissionAgreement {
  id                  String            @id @default(cuid())
  administradoraOrgId String
  supplierOrgId       String
  feeType             CommissionFeeType
  feeValue            Float
  durationMonths      Int?
  isRecurring         Boolean           @default(false)
  startsAt            DateTime          @default(now())
  endsAt              DateTime?
  notes               String?
  createdByUserId     String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  administradora Organization      @relation("CommissionAdm", fields: [administradoraOrgId], references: [id], onDelete: Cascade)
  supplier       Organization      @relation("CommissionSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  entries        CommissionEntry[]

  @@index([administradoraOrgId])
  @@index([supplierOrgId])
}

model CommissionEntry {
  id                  String                @id @default(cuid())
  agreementId         String?
  administradoraOrgId String
  supplierOrgId       String
  quotationId         String?
  proposalId          String?
  conditionId         String?
  categoryId          String?
  volumeCents         Int
  commissionCents     Int
  yearMonth           String
  status              CommissionEntryStatus @default(expected)
  notes               String?
  createdAt           DateTime              @default(now())

  agreement      CommissionAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  administradora Organization         @relation("CommissionEntryAdm", fields: [administradoraOrgId], references: [id], onDelete: Cascade)
  supplier       Organization         @relation("CommissionEntrySupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)

  @@index([administradoraOrgId, yearMonth])
  @@index([supplierOrgId, yearMonth])
  @@index([quotationId])
}

model CategoryAddonPurchase {
  id             String   @id @default(cuid())
  organizationId String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  checkoutId     String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkout     PaymentCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String
  accepted  Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}

enum ReferralRewardKind {
  recurring_credit
  discount
  commission_share
}

model ReferralReward {
  id              String             @id @default(cuid())
  referrerUserId  String
  referredUserId  String
  kind            ReferralRewardKind @default(recurring_credit)
  amountCents     Int                @default(0)
  notes           String?
  yearMonth       String?
  createdAt       DateTime           @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([referredUserId])
}
