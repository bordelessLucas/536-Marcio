generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  fornecedor
  sindico
  administradora
  master_admin
  master_service
}

enum ServicePipelineStatus {
  em_liberacao
  em_andamento
  em_negociacao
  em_analise
  recusada
  aprovada
}

enum RifAnalysisStatus {
  draft
  published
}

enum ServiceAiApiMode {
  platform
  client
}

enum MemberRole {
  master
  operational
  external_approver
}

enum AppointmentLeadMode {
  exact_date
  days_15
  days_30
  days_60
  days_90
}

enum AppointmentSource {
  approval
  manual
}

enum PlanAudience {
  solicitante
  fornecedor
  platform
}

enum SubscriptionStatus {
  pending
  paid
  active
  failed
  canceled
  past_due
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firebaseUid          String?   @unique
  name                 String
  emailVerifiedAt      DateTime?
  privacyAcceptedAt    DateTime?
  referralCode         String?   @unique
  referredByUserId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships          OrganizationMember[]
  emailTokens          EmailToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  consentRecords       ConsentRecord[]
  referredBy           User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals            User[]    @relation("UserReferrals")
  referralRewards      ReferralReward[] @relation("ReferralReferrer")
  referredRewards      ReferralReward[] @relation("ReferralReferred")
  notifications        Notification[]
  externalApproverScopes ExternalApproverScope[]
  externalApprovals    QuotationExternalApproval[]
  serviceAppointmentsCreated ServiceAppointment[] @relation("AppointmentCreator")
}

enum QuotationStatus {
  aberta
  em_negociacao
  aprovada
  recusada
  cancelada
  encerrada
  finalizada_outros
}

enum QuotationUrgency {
  baixa
  media
  alta
  critica
}

model Organization {
  id               String           @id @default(cuid())
  name             String
  document         String?
  type             OrganizationType
  googleProfileUrl String?
  reclameAquiUrl   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members              OrganizationMember[]
  subscriptions        Subscription[]
  planOverrides        PlanOverride[]
  condominiums         Condominium[]
  quotations           Quotation[]
  franchiseUsages      FranchiseUsage[]
  domainEvents         DomainEvent[]
  categories           OrganizationCategory[]
  complianceDocuments  ComplianceDocument[]
  quotationInvites     QuotationInvite[]
  proposals            Proposal[]
  favoriteSuppliers    FavoriteSupplier[]      @relation("FavoriteOwner")
  favoritedBy          FavoriteSupplier[]      @relation("FavoriteSupplierOrg")
  negotiationMessages  NegotiationMessage[]
  paymentCheckouts     PaymentCheckout[]
  subscriptionChanges  SubscriptionChange[]
  migrations           OrganizationMigration[]
  partnershipsAsAdm    Partnership[]           @relation("PartnershipAdm")
  partnershipsAsSupplier Partnership[]         @relation("PartnershipSupplier")
  commissionAgreements CommissionAgreement[]   @relation("CommissionAdm")
  commissionAsSupplier CommissionAgreement[]   @relation("CommissionSupplier")
  commissionEntries    CommissionEntry[]       @relation("CommissionEntryAdm")
  commissionEntrySupplier CommissionEntry[]    @relation("CommissionEntrySupplier")
  categoryAddonPurchases CategoryAddonPurchase[]
  serviceClientsManaged  ServiceClient[]           @relation("ServiceClientManager")
  serviceClientProfile   ServiceClient?            @relation("ServiceClientOrg")
  serviceQuotations      Quotation[]               @relation("ServiceManagedQuotations")
  externalApproverScopes ExternalApproverScope[]
  serviceAppointments    ServiceAppointment[]
}

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(master)
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Plan {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  description     String?
  audience        PlanAudience
  isFree          Boolean      @default(false)
  monthlyQuota    Int?
  priceCents      Int          @default(0)
  billingInterval String       @default("monthly")
  sortOrder       Int          @default(0)
  featuresJson    String       @default("{}")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptions       Subscription[]
  overrides           PlanOverride[]
  checkouts           PaymentCheckout[]
  changesFrom         SubscriptionChange[] @relation("ChangeFromPlan")
  changesTo           SubscriptionChange[] @relation("ChangeToPlan")
  migrations          OrganizationMigration[]
  pendingSubscriptions Subscription[]     @relation("PendingPlan")
}

model Subscription {
  id                    String             @id @default(cuid())
  organizationId        String
  planId                String
  status                SubscriptionStatus @default(active)
  startsAt              DateTime           @default(now())
  endsAt                DateTime?
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  pendingPlanId         String?
  externalCustomerId    String?
  externalSubscriptionId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model PlanOverride {
  id             String   @id @default(cuid())
  organizationId String
  planId         String?
  monthlyQuota   Int?
  featuresJson   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@unique([organizationId])
}

model ServiceCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  colorToken String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items              ServiceItem[]
  quotations         Quotation[]
  organizationLinks  OrganizationCategory[]
  favoriteLinks      FavoriteSupplier[]
  serviceAppointments ServiceAppointment[]
}

model OrganizationCategory {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  /// Segmento (ServiceItem). Obrigatório em novos vínculos; legado pode ser null até reseed.
  serviceItemId  String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  isIncluded     Boolean  @default(true)
  isAddon        Boolean  @default(false)
  unitPriceCents Int?
  checkoutId     String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceItem  ServiceItem?     @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  checkout     PaymentCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@unique([organizationId, categoryId, serviceItemId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([serviceItemId])
}

enum ComplianceStatus {
  aprovado
  em_analise
  em_atraso
  negada
}

model ComplianceDocument {
  id             String           @id @default(cuid())
  organizationId String
  documentType   String
  fileName       String
  storagePath    String
  contentType    String?
  sizeBytes      Int              @default(0)
  validUntil     DateTime
  status         ComplianceStatus @default(em_analise)
  reviewNotes    String?
  reviewedAt     DateTime?
  reviewedByUserId String?
  replacesId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replaces     ComplianceDocument? @relation("ComplianceHistory", fields: [replacesId], references: [id], onDelete: SetNull)
  renewals     ComplianceDocument[] @relation("ComplianceHistory")

  @@index([organizationId, status])
  @@index([organizationId, documentType])
  @@index([validUntil])
}

enum InviteStatus {
  pendente
  aceito
  declinado
  expirado
}

enum SupplierPipelineStage {
  nova
  em_andamento
  proposta_enviada
  negociacao
  ganha
  perdida
}

enum ProposalStatus {
  enviada
  em_negociacao
  aprovada
  recusada
}

model QuotationInvite {
  id                   String       @id @default(cuid())
  quotationId          String
  supplierOrgId        String
  status               InviteStatus @default(pendente)
  priorityTier         Int          @default(4)
  selectionReason      String?
  declineReason        String?
  supplierPipelineStage SupplierPipelineStage?
  acceptedAt           DateTime?
  declinedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  quotation  Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier   Organization @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  proposal   Proposal?

  @@unique([quotationId, supplierOrgId])
  @@index([supplierOrgId, status])
  @@index([supplierOrgId, supplierPipelineStage])
  @@index([quotationId])
}

model Proposal {
  id              String         @id @default(cuid())
  inviteId        String         @unique
  organizationId  String
  quotationId     String
  status          ProposalStatus @default(enviada)
  createdByUserId String
  metadataJson    String         @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  invite       QuotationInvite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  conditions   ProposalCondition[]
  messages     NegotiationMessage[]
  externalApprovals QuotationExternalApproval[]

  @@index([organizationId, status])
  @@index([quotationId])
}

model NegotiationMessage {
  id             String   @id @default(cuid())
  proposalId     String
  organizationId String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  proposal     Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model FavoriteSupplier {
  id             String   @id @default(cuid())
  organizationId String
  supplierOrgId  String
  categoryId     String?
  createdAt      DateTime @default(now())

  organization Organization     @relation("FavoriteOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Organization     @relation("FavoriteSupplierOrg", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, supplierOrgId])
  @@index([organizationId])
  @@index([supplierOrgId])
}

model ProposalCondition {
  id            String   @id @default(cuid())
  proposalId    String
  amountCents   Int
  paymentTerms  String
  sortOrder     Int      @default(0)
  metadataJson  String   @default("{}")
  createdAt     DateTime @default(now())

  proposal    Proposal                     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  attachments ProposalConditionAttachment[]

  @@index([proposalId])
}

model ProposalConditionAttachment {
  id          String   @id @default(cuid())
  conditionId String
  fileName    String
  storagePath String
  contentType String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  condition ProposalCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ServiceItem {
  id              String    @id @default(cuid())
  categoryId      String
  name            String
  slug            String
  isMandatory     Boolean   @default(false)
  periodicityHint String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category           ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quotations         Quotation[]
  organizationLinks  OrganizationCategory[]
  serviceAppointments ServiceAppointment[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Condominium {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  address        String
  document       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  towers         Int?
  units          Int?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  externalApproverScopes ExternalApproverScope[]
  serviceAppointments    ServiceAppointment[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Quotation {
  id                    String           @id @default(cuid())
  publicId              String           @unique
  organizationId        String
  condominiumId         String
  categoryId            String
  serviceItemId         String
  urgency               QuotationUrgency @default(media)
  description           String
  minProposals          Int              @default(3)
  maxProposals          Int              @default(10)
  proposalsCount        Int              @default(0)
  invitesPaused         Boolean          @default(false)
  status                QuotationStatus  @default(aberta)
  approvedProposalId    String?
  approvedConditionId   String?
  otherCompanyName      String?
  otherFinalAmountCents Int?
  createdByUserId       String
  /// Cota Service — vínculo com cliente gerenciado pelo Master Service
  serviceClientId       String?
  serviceManagedByOrgId String?
  servicePipelineStatus ServicePipelineStatus?
  requesterName         String?
  requesterEmail        String?
  requesterPhone        String?
  requesterRole         String?
  masterAcceptedAt      DateTime?
  solicitanteAcceptedAt DateTime?
  contactReleasedAt     DateTime?
  rifVisibleToClient    Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  condominium      Condominium            @relation(fields: [condominiumId], references: [id])
  category         ServiceCategory        @relation(fields: [categoryId], references: [id])
  serviceItem      ServiceItem            @relation(fields: [serviceItemId], references: [id])
  serviceClient    ServiceClient?         @relation(fields: [serviceClientId], references: [id], onDelete: SetNull)
  serviceManagedBy Organization?          @relation("ServiceManagedQuotations", fields: [serviceManagedByOrgId], references: [id], onDelete: SetNull)
  attachments      QuotationAttachment[]
  invites          QuotationInvite[]
  proposals        Proposal[]
  rifAnalyses      RifAnalysis[]
  externalApproval QuotationExternalApproval?
  serviceAppointments ServiceAppointment[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([categoryId])
  @@index([serviceItemId])
  @@index([serviceClientId, servicePipelineStatus])
  @@index([serviceManagedByOrgId, servicePipelineStatus])
}

/// Cliente do plano Cota Service (Administradora/Síndico) gerido pelo Master Service
model ServiceClient {
  id                     String           @id @default(cuid())
  managedByOrgId         String
  clientOrgId            String           @unique
  displayName            String
  logoUrl                String?
  primaryColor           String           @default("#9333EA")
  secondaryColor         String           @default("#14B8A6")
  solicitationLinkSlug   String           @unique
  solicitationLinkActive Boolean          @default(true)
  paymentLinkUrl         String?
  isActive               Boolean          @default(true)
  aiApiMode              ServiceAiApiMode @default(platform)
  aiApiKeyMasked         String?
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  managedBy  Organization @relation("ServiceClientManager", fields: [managedByOrgId], references: [id], onDelete: Cascade)
  clientOrg  Organization @relation("ServiceClientOrg", fields: [clientOrgId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  managers   ServiceClientManager[]
  externalApproverScopes ExternalApproverScope[]
  serviceAppointments    ServiceAppointment[]

  @@index([managedByOrgId])
  @@index([solicitationLinkSlug])
}

/// Gerente/assistente vinculado a um cliente Cota Service
model ServiceClientManager {
  id              String   @id @default(cuid())
  serviceClientId String
  userId          String
  name            String
  email           String
  roleLabel       String   @default("gerente")
  createdAt       DateTime @default(now())

  serviceClient ServiceClient @relation(fields: [serviceClientId], references: [id], onDelete: Cascade)

  @@unique([serviceClientId, email])
  @@index([serviceClientId])
  @@index([userId])
}

model RifAnalysis {
  id                String            @id @default(cuid())
  quotationId       String
  generatedByUserId String
  status            RifAnalysisStatus @default(draft)
  averageCents      Int?
  summaryMarkdown   String
  comparativeJson   String            @default("[]")
  aiInsights        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, createdAt])
}

model QuotationAttachment {
  id          String   @id @default(cuid())
  quotationId String
  fileName    String
  storagePath String
  contentType String?
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model FranchiseUsage {
  id             String   @id @default(cuid())
  organizationId String
  yearMonth      String
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
}

model DomainEvent {
  id             String   @id @default(cuid())
  type           String
  entityType     String
  entityId       String
  organizationId String?
  payload        String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([organizationId])
  @@index([entityType, entityId])
}

enum BannerAudienceMode {
  all
  profiles
  users
}

model LandingBanner {
  id                   String             @id @default(cuid())
  title                String?
  imageUrl             String
  linkUrl              String?
  sortOrder            Int                @default(0)
  isActive             Boolean            @default(true)
  showOnLanding        Boolean            @default(true)
  showInApp            Boolean            @default(true)
  scrollIntervalMs     Int                @default(5500)
  audienceMode         BannerAudienceMode @default(all)
  targetProfilesJson   String             @default("[]")
  targetUserIdsJson    String             @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model MarketingSettings {
  id              String   @id @default("default")
  whatsappUrl     String?
  blogUrl         String?
  pixelScripts    String?
  supplierLpHost  String?
  maxActiveBanners Int     @default(10)
  updatedAt       DateTime @updatedAt
}

model PlatformSettings {
  id                      String   @id @default("default")
  freeQuotaSolicitante    Int      @default(15)
  freeQuotaFornecedor     Int      @default(1)
  supplierProQuota        Int      @default(30)
  supplierPremiumQuota    Int      @default(100)
  reminderDaysJson        String   @default("[5,10]")
  partnershipLockEnabled  Boolean  @default(true)
  categoryAddonPriceCents Int      @default(2900)
  updatedAt               DateTime @updatedAt
}

model Notification {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  type           String
  title          String
  body           String
  href           String?
  metadataJson   String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
}

model EmailOutbox {
  id           String    @id @default(cuid())
  toEmail      String
  subject      String
  bodyText     String
  template     String
  status       String    @default("queued")
  metadataJson String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([template])
  @@index([toEmail])
}

model ReminderDispatch {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  kind      String
  entityId  String
  createdAt DateTime @default(now())

  @@index([kind, entityId])
}

enum CheckoutKind {
  plan
  category_addon
  migration
  custom
}

enum CheckoutStatus {
  pending
  paid
  failed
  canceled
  expired
}

enum PartnershipStatus {
  active
  blocked
  ended
}

enum MigrationStatus {
  pending_payment
  pending_review
  approved
  rejected
  canceled
}

enum CommissionFeeType {
  fixed
  percent
}

enum CommissionEntryStatus {
  expected
  accrued
  paid
  canceled
}

model PaymentCheckout {
  id               String         @id @default(cuid())
  organizationId   String
  userId           String?
  kind             CheckoutKind
  planId           String?
  status           CheckoutStatus @default(pending)
  provider         String         @default("sandbox")
  amountCents      Int
  quantity         Int            @default(1)
  currency         String         @default("BRL")
  externalId       String?        @unique
  idempotencyKey   String         @unique
  metadataJson     String         @default("{}")
  paidAt           DateTime?
  failedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             Plan?          @relation(fields: [planId], references: [id])
  orgCategories    OrganizationCategory[]
  migrations       OrganizationMigration[]
  addonPurchases   CategoryAddonPurchase[]

  @@index([organizationId, status])
  @@index([kind])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payloadJson String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType])
}

model SubscriptionChange {
  id             String   @id @default(cuid())
  organizationId String
  fromPlanId     String?
  toPlanId       String
  changeType     String
  prorationCents Int      @default(0)
  effectiveAt    DateTime
  checkoutId     String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromPlan     Plan?        @relation("ChangeFromPlan", fields: [fromPlanId], references: [id])
  toPlan       Plan         @relation("ChangeToPlan", fields: [toPlanId], references: [id])

  @@index([organizationId, createdAt])
}

model OrganizationMigration {
  id             String           @id @default(cuid())
  organizationId String
  fromType       OrganizationType
  toType         OrganizationType @default(administradora)
  targetPlanId   String
  status         MigrationStatus  @default(pending_payment)
  checkoutId     String?
  requestedByUserId String
  reviewedByUserId  String?
  reviewNotes    String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetPlan   Plan             @relation(fields: [targetPlanId], references: [id])
  checkout     PaymentCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status])
}

model Partnership {
  id                  String            @id @default(cuid())
  administradoraOrgId String
  supplierOrgId       String
  status              PartnershipStatus @default(active)
  lockedReason        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  administradora Organization @relation("PartnershipAdm", fields: [administradoraOrgId], references: [id], onDelete: Cascade)
  supplier       Organization @relation("PartnershipSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)

  @@unique([administradoraOrgId, supplierOrgId])
  @@index([administradoraOrgId])
  @@index([supplierOrgId])
}

model CommissionAgreement {
  id                  String            @id @default(cuid())
  administradoraOrgId String
  supplierOrgId       String
  feeType             CommissionFeeType
  feeValue            Float
  durationMonths      Int?
  isRecurring         Boolean           @default(false)
  startsAt            DateTime          @default(now())
  endsAt              DateTime?
  notes               String?
  createdByUserId     String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  administradora Organization      @relation("CommissionAdm", fields: [administradoraOrgId], references: [id], onDelete: Cascade)
  supplier       Organization      @relation("CommissionSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  entries        CommissionEntry[]

  @@index([administradoraOrgId])
  @@index([supplierOrgId])
}

model CommissionEntry {
  id                  String                @id @default(cuid())
  agreementId         String?
  administradoraOrgId String
  supplierOrgId       String
  quotationId         String?
  proposalId          String?
  conditionId         String?
  categoryId          String?
  volumeCents         Int
  commissionCents     Int
  yearMonth           String
  status              CommissionEntryStatus @default(expected)
  notes               String?
  createdAt           DateTime              @default(now())

  agreement      CommissionAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  administradora Organization         @relation("CommissionEntryAdm", fields: [administradoraOrgId], references: [id], onDelete: Cascade)
  supplier       Organization         @relation("CommissionEntrySupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)

  @@index([administradoraOrgId, yearMonth])
  @@index([supplierOrgId, yearMonth])
  @@index([quotationId])
}

model CategoryAddonPurchase {
  id             String   @id @default(cuid())
  organizationId String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  checkoutId     String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkout     PaymentCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

/// Escopo de condomínios visíveis para um Aprovador Externo
model ExternalApproverScope {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  condominiumId   String
  serviceClientId String?
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  condominium   Condominium   @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  serviceClient ServiceClient? @relation(fields: [serviceClientId], references: [id], onDelete: SetNull)

  @@unique([userId, condominiumId])
  @@index([organizationId])
  @@index([serviceClientId])
}

/// Registro de aprovação externa com motivo e recorrência
model QuotationExternalApproval {
  id                        String    @id @default(cuid())
  quotationId               String    @unique
  approvedByUserId          String
  proposalId                String?
  reason                    String
  nextContractDate          DateTime?
  nextContractNotApplicable Boolean   @default(false)
  rejected                  Boolean   @default(false)
  rejectionReason           String?
  approvedAt                DateTime  @default(now())
  ip                        String?

  quotation   Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approvedBy  User                @relation(fields: [approvedByUserId], references: [id], onDelete: Cascade)
  proposal    Proposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  appointment ServiceAppointment?

  @@index([approvedByUserId])
  @@index([approvedAt])
}

/// Compromisso no Calendário de Serviços (aprovação ou cadastro manual)
model ServiceAppointment {
  id                 String              @id @default(cuid())
  organizationId     String
  serviceClientId    String?
  condominiumId      String
  categoryId         String
  serviceItemId      String?
  appointmentDate    DateTime
  leadMode           AppointmentLeadMode
  leadExactDate      DateTime?
  source             AppointmentSource
  quotationId        String?
  externalApprovalId String?             @unique
  createdByUserId    String
  notes              String?
  lastDispatchedAt   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceClient    ServiceClient?            @relation(fields: [serviceClientId], references: [id], onDelete: SetNull)
  condominium      Condominium               @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  category         ServiceCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceItem      ServiceItem?              @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  quotation        Quotation?                @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  externalApproval QuotationExternalApproval? @relation(fields: [externalApprovalId], references: [id], onDelete: SetNull)
  createdBy        User                      @relation("AppointmentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, appointmentDate])
  @@index([serviceClientId, appointmentDate])
  @@index([condominiumId])
  @@index([categoryId])
  @@index([quotationId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String
  accepted  Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}

enum ReferralRewardKind {
  recurring_credit
  discount
  commission_share
}

model ReferralReward {
  id              String             @id @default(cuid())
  referrerUserId  String
  referredUserId  String
  kind            ReferralRewardKind @default(recurring_credit)
  amountCents     Int                @default(0)
  notes           String?
  yearMonth       String?
  createdAt       DateTime           @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([referredUserId])
}
