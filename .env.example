# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Auth session (cookies da área /app — complementar ao Firebase Auth)
AUTH_SECRET=cotacondo-dev-secret-change-me-in-production-32chars

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Database local temporário (bootstrap — alvo oficial é Firestore)
# Em Vercel/produção, use Postgres (ex.: Neon/Supabase Postgres) em vez de file:./dev.db
DATABASE_URL="file:./dev.db"

# Firebase Admin (server). Sem isso, anexos usam /uploads local.
# Login/cadastro usam Firebase Auth REST com NEXT_PUBLIC_FIREBASE_API_KEY (Spark OK).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/serviceAccount.json

# Após db:setup, sincronize demos no Auth:
# npm run seed:firebase-auth
# Senha demo: 123456

# Marketing placeholders
NEXT_PUBLIC_BLOG_URL=https://blog.cotacondo.com.br
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5500000000000

# Billing / Gateway: "sandbox" (simulador interno) ou "asaas"
PAYMENT_PROVIDER=asaas
# Ambiente da API Asaas: sandbox | production
ASAAS_ENVIRONMENT=sandbox
# Use chaves distintas por ambiente. Nunca exponha estas variáveis no client.
ASAAS_SANDBOX_API_KEY=
ASAAS_PRODUCTION_API_KEY=
# Token próprio configurado no webhook Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Endpoint: https://SEU_DOMINIO/api/webhooks/asaas
# Segredo opcional para POST /api/webhooks/sandbox (header x-webhook-signature)
PAYMENT_WEBHOOK_SECRET=cotacondo-webhook-dev-secret
# Outros providers futuros:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAGARME_SECRET_KEY=

# E-mail (Dia 6) — sem chave = ConsoleEmailProvider (grava EmailOutbox)
# RESEND_API_KEY=
# EMAIL_FROM=CotaCondo <onboarding@resend.dev>

# Motor de distribuição (Dia 4)
# DISTRIBUTION_ENGINE_ENABLED=true

# Deploy: app Next na Vercel; Firebase Spark = rules + Storage + hosting-static
# npx firebase-tools@latest deploy --only firestore:rules,storage,hosting --project marcio-ab7d9
